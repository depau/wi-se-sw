    "webpack": "^5.101.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "copy-webpack-plugin": "^9.1.0",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.3",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.2",
    "util": "^0.12.5",
    "style-loader": "^4.0.0",
